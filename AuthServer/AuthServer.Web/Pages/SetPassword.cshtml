@model AuthServer.Web.Pages.SetPasswordModel

@if (!Model.TokenValid)
{
    <p>Linkki on virheellinen tai vanhentunut.</p>
}
else
{
    <div class="card">
        <h1 class="card-header">Aseta salasana</h1>
        <form method="post" class="card-body">
            <input type="hidden" asp-for="Token" />
            <label asp-for="Password">Salasana</label>
            <input asp-for="Password" type="password" />
            <label asp-for="ConfirmPassword">Salasana uudelleen</label>
            <input asp-for="ConfirmPassword" type="password" />
            <div asp-validation-summary="All"></div>
            <button class="btn btn-primary" type="submit">Aseta</button>
        </form>
    </div>
}