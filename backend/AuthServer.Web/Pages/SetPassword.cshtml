@page
@using AuthServer.Domain.Users
@model AuthServer.Web.Pages.SetPasswordModel
@if (Model.TokenType is null)
{
    <h1 class="card-title justify-center text-2xl">Linkki ei kelpaa</h1>
    <p>Linkki on virheellinen, vanhentunut tai jo käytetty.</p>
    <a class="link" asp-page="ForgotPassword">Pyydä uusi linkki</a>
}
else
{
    var reset = Model.TokenType == PasswordTokenTypes.Reset;

    <h1 class="card-title justify-center text-2xl">@(reset ? "Vaihda salasana" : "Aseta salasana")</h1>
    <form method="post" class="flex flex-col gap-4">
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="ClientId" />
        <label class="flex flex-col gap-1">
            <span class="label">@(reset ? "Uusi salasana" : "Salasana")</span>
            <input asp-for="Password" type="password" class="input w-full" autocomplete="new-password" required />
        </label>
        <label class="flex flex-col gap-1">
            <span class="label">Salasana uudelleen</span>
            <input asp-for="ConfirmPassword" type="password" class="input w-full" autocomplete="new-password" required />
        </label>
        <div asp-validation-summary="All" class="text-error"></div>
        <button class="btn btn-primary" type="submit">@(reset ? "Vaihda" : "Aseta")</button>
    </form>
}
