@page
@using AuthServer.Domain.Users
@model AuthServer.Web.Pages.SetPasswordModel

@if (Model.TokenType is null)
{
    <div class="card">
        <h1 class="card-header">Linkki ei kelpaa</h1>
        <div class="card-body">
            <p>Linkki on virheellinen, vanhentunut tai jo käytetty.</p>
            <p><a asp-page="ForgotPassword">Pyydä uusi linkki</a></p>
        </div>
    </div>
}
else
{
    var reset = Model.TokenType == PasswordTokenTypes.Reset;

    <div class="card">
        <h1 class="card-header">@(reset ? "Vaihda salasana" : "Aseta salasana")</h1>
        <form method="post" class="card-body">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="ClientId" />
            <label asp-for="Password">@(reset ? "Uusi salasana" : "Salasana")</label>
            <input asp-for="Password" type="password" autocomplete="new-password" required />
            <label asp-for="ConfirmPassword">Salasana uudelleen</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
            <div asp-validation-summary="All"></div>
            <button class="btn btn-primary" type="submit">@(reset ? "Vaihda" : "Aseta")</button>
        </form>
    </div>
}
