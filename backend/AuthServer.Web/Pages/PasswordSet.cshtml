@page
@model AuthServer.Web.Pages.PasswordSetModel

<div class="card">
    <h1 class="card-header">Salasana asetettu</h1>
    <div class="card-body">
        @if (Model.LoginUri is not null)
        {
            <p>Salasana on asetettu.</p>
            <a class="btn btn-primary" href="@Model.LoginUri">Kirjaudu: @Model.AppName</a>
        }
        else
        {
            <p>Salasana on asetettu. Palaa sovellukseen, josta sait kutsun, ja kirjaudu sisään.</p>
        }
    </div>
</div>
