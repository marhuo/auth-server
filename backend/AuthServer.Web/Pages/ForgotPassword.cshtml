@page
@model AuthServer.Web.Pages.ForgotPasswordModel
<h1 class="card-title justify-center text-2xl">Unohtuiko salasana?</h1>
@if (Model.Sent)
{
    <p>Jos osoitteella on käyttäjätili, lähetimme siihen linkin salasanan vaihtamiseen. Linkki on voimassa tunnin.</p>
    <a class="link" asp-page="Login">Takaisin kirjautumiseen</a>
}
else
{
    <form method="post" class="flex flex-col gap-4">
        <div asp-validation-summary="ModelOnly" class="text-error"></div>
        <p>Anna sähköpostiosoitteesi, niin lähetämme linkin salasanan vaihtamiseen.</p>
        <input asp-for="Email" type="email" class="input w-full" placeholder="Sähköposti" autocomplete="username" autofocus required />
        <partial name="_Turnstile" />
        <button class="btn btn-primary" type="submit">Lähetä linkki</button>
        <a class="link text-sm" asp-page="Login">Takaisin kirjautumiseen</a>
    </form>
}
