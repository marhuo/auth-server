@page
@model AuthServer.Web.Pages.ForgotPasswordModel

<div class="card">
    <h1 class="card-header">Unohtuiko salasana?</h1>
    <div class="card-body">
        @if (Model.Sent)
        {
            <p>Jos osoitteella on käyttäjätili, lähetimme siihen linkin salasanan vaihtamiseen. Linkki on voimassa tunnin.</p>
            <p><a asp-page="Login">Takaisin kirjautumiseen</a></p>
        }
        else
        {
            <form method="post">
                <p>Anna sähköpostiosoitteesi, niin lähetämme linkin salasanan vaihtamiseen.</p>
                <input asp-for="Email" type="email" placeholder="Sähköposti" autocomplete="username" autofocus required />
                <button class="btn btn-primary send-link" type="submit">Lähetä linkki</button>
                 <p><a asp-page="Login">Takaisin kirjautumiseen</a></p>
            </form>
           
        }
    </div>
</div>
