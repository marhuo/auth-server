@page
@model AuthServer.Web.Pages.LoginModel
@{
    var heading = Model.Create ? "Luo tunnus" : "Kirjaudu";
}
<h1 class="card-title justify-center text-2xl">@heading</h1>
@if (Model.AppName is not null)
{
    <p class="text-center">sovellukseen <strong>@Model.AppName</strong></p>
}
@if (!Model.ShowCodeForm)
{
    <form method="post" asp-page-handler="Send" class="flex flex-col gap-4">
        <div asp-validation-summary="ModelOnly" class="text-error"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <input asp-for="Create" type="hidden" />
        <p>Anna sähköpostiosoitteesi, niin lähetämme kirjautumiskoodin.</p>
        <input asp-for="Email" type="email" class="input w-full" placeholder="Sähköposti" autocomplete="username" autofocus required />
        <partial name="_Turnstile" />
        <button class="btn btn-primary" type="submit">Lähetä koodi</button>
        <partial name="_ExternalLoginButtons" model="Model.ReturnUrl" />
    </form>
}
else
{
    <form method="post" asp-page-handler="Verify" class="flex flex-col gap-4">
        <div asp-validation-summary="ModelOnly" class="text-error"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <input asp-for="Email" type="hidden" />
        <input asp-for="Create" type="hidden" />
        <p>Lähetimme koodin ja linkin osoitteeseen <strong>@Model.Email</strong>. Kirjoita koodi tai avaa linkki. Ne ovat voimassa 30 minuuttia.</p>
        <input asp-for="Code" type="text" class="input w-full" placeholder="Koodi" inputmode="numeric"
               autocomplete="one-time-code" maxlength="6" autofocus required />
        <button class="btn btn-primary" type="submit">Kirjaudu</button>
        <a class="link text-sm" asp-page="Login" asp-route-email="@Model.Email" asp-route-returnUrl="@Model.ReturnUrl"
           asp-route-create="@(Model.Create ? "true" : null)">Pyydä uusi koodi</a>
    </form>
}
