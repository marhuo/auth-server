@page
@model AuthServer.Web.Pages.RegisterModel
<h1 class="card-title justify-center text-2xl">Luo tunnus</h1>
@if (Model.Sent)
{
    <p>
        Lähetimme linkin osoitteeseen <strong>@Model.Email</strong>. Avaa linkki ja aseta salasana, niin tunnus on
        valmis. Linkki on voimassa 7 päivää.
    </p>
    <p>Jos sinulla on jo tunnus, saat sen sijaan ohjeen kirjautumiseen.</p>
    <a class="link" asp-page="Login" asp-route-returnUrl="@Model.ReturnUrl">Takaisin kirjautumiseen</a>
}
else
{
    <form method="post" class="flex flex-col gap-4">
        <div asp-validation-summary="ModelOnly" class="text-error"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <p>Anna sähköpostiosoitteesi, niin lähetämme linkin salasanan asettamiseen.</p>
        <input asp-for="Email" type="email" class="input w-full" placeholder="Sähköposti" autocomplete="username" autofocus required />
        <partial name="_Turnstile" />
        <button class="btn btn-primary" type="submit">Jatka</button>
        <partial name="_ExternalLoginButtons" model="Model.ReturnUrl" />
        <p class="text-sm">
            Onko sinulla jo tunnus?
            <a class="link" asp-page="Login" asp-route-returnUrl="@Model.ReturnUrl">Kirjaudu</a>
        </p>
    </form>
}
