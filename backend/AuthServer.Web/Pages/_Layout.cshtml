<!DOCTYPE html>
<html lang="fi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "AuthServer")</title>
    @* daisyui.css: daisyUI and common Tailwind classes, a ready-made file like Bootstrap. site.css: the theme and own styles. *@
    <link rel="stylesheet" href="~/css/daisyui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/google-button.css" asp-append-version="true" />
</head>

<body class="bg-base-100 min-h-screen">
    <main role="main" class="flex justify-center px-4 pt-12">
        <div class="card bg-base-100 border-base-300 w-full max-w-sm border">
            <div class="card-body gap-4">
                @RenderBody()
            </div>
        </div>
    </main>
</body>

</html>
