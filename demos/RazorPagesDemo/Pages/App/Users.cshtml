@page
@model UsersModel
@{
    ViewData["Title"] = "Käyttäjät";
}

<div class="card bg-base-100 border-base-300 border">
    <div class="card-body">
        <h1 class="card-title text-2xl">Kutsu käyttäjä</h1>
        <form method="post" class="flex flex-col gap-4">
            <label class="flex flex-col gap-1">
                <span class="label">Sähköposti</span>
                <input type="email" class="input w-full" asp-for="Email" required />
            </label>

            @if (Model.Error is not null)
            {
                <p class="text-error">@Model.Error</p>
            }
            @if (Model.InvitedEmail is not null)
            {
                <p>
                    <strong>@Model.InvitedEmail</strong> sai roolin <code>@Roles.User</code>.
                    Kutsusähköposti näkyy autentikointipalvelimen lokissa (rivi <code>Invite for @Model.InvitedEmail</code>).
                    Käyttäjä kirjautuu sähköpostiin tulevalla koodilla.
                </p>
            }

            <button class="btn btn-primary self-start" type="submit">Kutsu käyttäjäksi</button>
        </form>
    </div>
</div>

<div class="explain">
    <h2>Mitä tässä tapahtuu</h2>
    <ul>
        <li>Sivu näkyy vain roolille <code>@Roles.TenantAdmin</code>. Sovellus päättää sen itse.</li>
        <li>Sovellus kutsuu <code>POST api/user/invite</code>: tenantti on sinun tokenisi <code>tenant_id</code>, rooli <code>@Roles.User</code>.</li>
        <li>Kokeile: kirjaudu ulos, kirjaudu kutsuttuna. Laskutus-sivulla ei ole Osta-nappia, koska roolisi on <code>@Roles.User</code>.</li>
    </ul>
</div>
