@page
@model DomainsModel
@{
    ViewData["Title"] = "Domainit";
}

<div class="card bg-base-100 border-base-300 border">
    <div class="card-body">
        <h1 class="card-title text-2xl">Domainit</h1>

        @if (Model.Error is not null)
        {
            <p class="text-error">@Model.Error</p>
        }

        @if (Model.Domains.Count == 0)
        {
            <p>Ei domaineja.</p>
        }

        @foreach (var domain in Model.Domains)
        {
            <div class="border-base-300 flex flex-col gap-2 border-t py-3">
                <p>
                    <strong>@domain.Name</strong>
                    @if (domain.VerifiedAt is not null)
                    {
                        <span class="badge badge-success">Vahvistettu</span>
                    }
                    else
                    {
                        <span class="badge badge-warning">Ei vahvistettu</span>
                    }
                </p>

                @if (domain.VerifiedAt is null)
                {
                    <p>Lisää domainin DNS-asetuksiin TXT-rivi:</p>
                    <p><code>@domain.TxtRecord</code></p>
                }

                <div class="flex gap-2">
                    @if (domain.VerifiedAt is null)
                    {
                        <form method="post" asp-page-handler="Verify" asp-route-id="@domain.Id">
                            <button class="btn btn-primary btn-sm" type="submit">Tarkista</button>
                        </form>
                    }
                    <form method="post" asp-page-handler="Delete" asp-route-id="@domain.Id">
                        <button class="btn btn-secondary btn-sm" type="submit">Poista</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<div class="card bg-base-100 border-base-300 border">
    <div class="card-body">
        <h2 class="card-title">Lisää domain</h2>
        <form method="post" asp-page-handler="Add" class="flex flex-col gap-4">
            <label class="flex flex-col gap-1">
                <span class="label">Domain</span>
                <input type="text" class="input w-full" asp-for="Name" placeholder="acme.fi" required />
            </label>
            <button class="btn btn-primary self-start" type="submit">Lisää</button>
        </form>
    </div>
</div>

<div class="explain">
    <h2>Mitä tässä tapahtuu</h2>
    <ol>
        <li>Lisää yrityksesi domain. Autentikointipalvelin antaa sille TXT-rivin.</li>
        <li>Lisää rivi domainin DNS-asetuksiin siellä, mistä domain on ostettu.</li>
        <li>Paina Tarkista. Autentikointipalvelin lukee domainin DNS:n ja vahvistaa domainin, jos rivi löytyy.</li>
    </ol>
    <p>Sivu näkyy vain roolille <code>@Roles.TenantAdmin</code>. Sovellus kutsuu autentikointipalvelimen API:a <code>api/tenant/{tenantId}/domain</code>.</p>
</div>
