@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    // Empty until the user has a tenant.
    var tenantId = signedIn ? User.FindTenantId() : null;
}
<!DOCTYPE html>
<html lang="fi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – Razor Pages demo</title>
    <style>
        :root { --bg: #f6f7f9; --card: #fff; --text: #1d2330; --muted: #5d6676; --line: #dde1e7; --accent: #2f6fde; --ok: #1f8a4c; --warn: #b26a00; }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: system-ui, sans-serif; background: var(--bg); color: var(--text); line-height: 1.5; }
        header { background: var(--card); border-bottom: 1px solid var(--line); padding: 12px 24px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
        header .brand { font-weight: 700; font-size: 18px; color: var(--text); text-decoration: none; }
        header nav { display: flex; gap: 16px; flex: 1; }
        header nav a { color: var(--accent); text-decoration: none; }
        .who { font-size: 13px; color: var(--muted); text-align: right; }
        .who strong { color: var(--text); }
        main { max-width: 760px; margin: 32px auto; padding: 0 16px; }
        .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 20px 24px; margin-bottom: 20px; }
        .explain { background: #eef3fc; border: 1px solid #c9d8f5; border-radius: 8px; padding: 12px 16px; font-size: 14px; margin-bottom: 20px; }
        .explain h2 { font-size: 14px; margin: 0 0 4px; }
        .explain ol, .explain ul { margin: 4px 0; padding-left: 20px; }
        label { display: block; font-size: 14px; margin: 12px 0 4px; }
        input[type=text], input[type=email] { width: 100%; padding: 8px 10px; border: 1px solid var(--line); border-radius: 6px; font: inherit; }
        button, .button { display: inline-block; margin-top: 16px; padding: 8px 16px; border: 0; border-radius: 6px; background: var(--accent); color: #fff; font: inherit; cursor: pointer; text-decoration: none; }
        .button.secondary { background: #e7ebf1; color: var(--text); }
        .link-button { background: none; color: var(--accent); padding: 0; margin: 0; }
        .error { color: #b3261e; }
        .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 13px; }
        .badge.ok { background: #e3f4ea; color: var(--ok); }
        .badge.warn { background: #fdf0dc; color: var(--warn); }
        table { border-collapse: collapse; width: 100%; }
        td { padding: 6px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
        td:first-child { color: var(--muted); width: 40%; }
        code { background: #eef0f3; padding: 1px 5px; border-radius: 4px; font-size: 13px; }
    </style>
</head>
<body>
    <header>
        <a class="brand" href="/">Razor Pages demo</a>
        @if (signedIn)
        {
            @* asp-page adds the security token the form needs. *@
            @if (tenantId is not null)
            {
                <form method="post" asp-page="/SwitchTenant">
                    <select name="tenantId" onchange="this.form.submit()">
                        @foreach (var t in User.Tenants())
                        {
                            <option value="@t.Id" selected="@(t.Id == tenantId)">@t.Name</option>
                        }
                    </select>
                </form>
            }
            <nav>
                @if (tenantId is not null)
                {
                    <a href="/App">Sovellus</a>
                    <a href="/App/Billing">Laskutus</a>
                    @if (User.IsTenantAdmin())
                    {
                        <a href="/App/Users">Käyttäjät</a>
                    }
                }
            </nav>
            <div class="who">
                @User.Email() · @(User.RoleNames().Count > 0 ? string.Join(", ", User.RoleNames()) : "ei rooleja")
            </div>
            <form method="post" asp-page="/Logout">
                <button class="link-button" type="submit">Kirjaudu ulos</button>
            </form>
        }
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
