@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    // Empty until the user has a tenant.
    var tenantId = signedIn ? User.FindTenantId() : null;
}
<!DOCTYPE html>
<html lang="fi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – Razor Pages demo</title>
    @* daisyui.css: daisyUI and common Tailwind classes, a ready-made file like Bootstrap. site.css: the theme and own styles. *@
    <link rel="stylesheet" href="~/css/daisyui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-base-100 min-h-screen">
    <header class="navbar bg-base-200 border-base-300 flex-wrap gap-4 border-b px-6">
        <a class="text-lg font-bold" href="/">Razor Pages demo</a>
        @if (signedIn)
        {
            @if (tenantId is not null)
            {
                @* asp-controller adds the security token the form needs. *@
                <form method="post" asp-controller="Account" asp-action="SwitchTenant">
                    <select name="tenantId" class="select select-sm" onchange="this.form.submit()">
                        @foreach (var t in User.Tenants())
                        {
                            <option value="@t.Id" selected="@(t.Id == tenantId)">@t.Name</option>
                        }
                    </select>
                </form>
            }
            <nav class="flex flex-1 gap-4">
                @if (tenantId is not null)
                {
                    <a class="link link-hover" href="/App">Sovellus</a>
                    <a class="link link-hover" href="/App/Billing">Laskutus</a>
                    @if (User.IsTenantAdmin())
                    {
                        <a class="link link-hover" href="/App/Users">Käyttäjät</a>
                        <a class="link link-hover" href="/App/Domains">Domainit</a>
                    }
                }
            </nav>
            <div class="text-base-content/70 text-sm">
                @User.Email() · @(User.RoleNames().Count > 0 ? string.Join(", ", User.RoleNames()) : "ei rooleja")
            </div>
            <form method="post" asp-controller="Account" asp-action="Logout">
                <button class="btn btn-ghost btn-sm" type="submit">Kirjaudu ulos</button>
            </form>
        }
    </header>
    <main class="mx-auto box-content flex max-w-md flex-col gap-5 px-4 pt-12 pb-12">
        @RenderBody()
    </main>
</body>

</html>
